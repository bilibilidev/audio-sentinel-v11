config AE_AUDIODETECT
	tristate "CNN v2 audio event detection (5 classes + alarm + keyword)"
	default n
	---help---
		Enable the lightweight offline audio event detection demo.
		Detects background, cough, glass_break, baby_cry and dog_bark
		using the exported causal CNN v2 (INT8 weights, float arithmetic).
		Includes local alarm, optional remote HTTP/MQTT
		alarm reporting, multi-SNR robustness checks and keyword recognition.

if AE_AUDIODETECT

config AE_AUDIODETECT_PROGNAME
	string "Program name"
	default "audiodetect"

config AE_AUDIODETECT_PRIORITY
	int "audiodetect task priority"
	default 100

config AE_AUDIODETECT_STACKSIZE
	int "audiodetect stack size (bytes)"
	default 65536

config AE_AUDIODETECT_UI
	bool "Touch interface with continuous microphone monitoring"
	default n
	depends on GRAPHICS_LVGL
	---help---
		Enable a 320x240 LVGL touch interface. The interface records
		three-second segments, analyzes each file through the shared causal
		CNN v2 core, and displays the current class and confidence. Capture
		still uses arecord segments; gapless microphone I/O is not provided.

if AE_AUDIODETECT_UI

config AE_AUDIODETECT_UI_AUTOSTART
	bool "Start the touch interface during board boot"
	default y

config AE_AUDIODETECT_UI_INPUT_DEVPATH
	string "Touchscreen input device"
	default "/dev/input0"

endif

endif
